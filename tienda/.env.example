# ------------------------------------------------------------------
# Copia este archivo como .env y completa los valores.
# NUNCA subas el .env real al repositorio.
# ------------------------------------------------------------------

# Entorno: development | testing | production
APP_ENV=development

# Clave secreta (mín. 32 caracteres en producción). Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Base de datos
#   Desarrollo: sqlite:///instance/dev.sqlite3 (por defecto si se deja vacío)
#   Producción: postgresql://usuario:clave@host:5432/tienda
DATABASE_URL=

# URL pública del sitio (SEO, enlaces de correos, verificación de origen)
PUBLIC_BASE_URL=http://localhost:5000
# Orígenes adicionales permitidos (p. ej. una app o un panel en otro dominio), separados por comas
CORS_ALLOWED_ORIGINS=

# Migraciones automáticas al arrancar (útil en contenedores)
AUTO_MIGRATE=false

# Frontend: en desarrollo lo sirve Flask; en producción, nginx
SERVE_FRONTEND=true

# Archivos subidos
UPLOAD_DIR=
MAX_UPLOAD_MB=8

# Sesiones y cookies
SESSION_COOKIE_SECURE=false
SESSION_HOURS=12
SESSION_REMEMBER_DAYS=30

# Protección contra fuerza bruta y rate limiting (peticiones/segundos)
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/60
RATE_LIMIT_AUTH=10/60
RATE_LIMIT_CHECKOUT=20/60
# true solo detrás de un proxy de confianza (nginx) que fije X-Forwarded-For
TRUST_PROXY_HEADERS=false

# Proveedores de pago habilitados (orden del checkout).
# Disponibles: cash_on_delivery, bank_transfer, sandbox_card (sandbox_card solo en desarrollo)
PAYMENT_PROVIDERS=cash_on_delivery,bank_transfer
# Claves de proveedores futuros (ejemplo, aún no implementados):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# Correo: console (escribe en el log) hasta definir proveedor
MAIL_BACKEND=console
MAIL_FROM=no-reply@example.com

LOG_LEVEL=INFO
CACHE_PUBLIC_SECONDS=60

# Solo para docker-compose
POSTGRES_DB=tienda
POSTGRES_USER=tienda
POSTGRES_PASSWORD=
